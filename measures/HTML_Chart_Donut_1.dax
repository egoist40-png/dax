HTML_Chart_Donut 1 =
VAR maxH = 150

VAR allYM =
    ALLSELECTED ( DateTimeTable[Year_Month_NUM] )

VAR ymWithData =
    FILTER (
        allYM,
        VAR ym = DateTimeTable[Year_Month_NUM]
        RETURN CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ym ) ) > 0
    )
VAR lastYM   = MAXX ( ymWithData, DateTimeTable[Year_Month_NUM] )
VAR curYear  = QUOTIENT ( lastYM, 100 )
VAR curMonth = MOD ( lastYM, 100 )
VAR prevYear = curYear - 1

VAR monthList =
    SELECTCOLUMNS ( GENERATESERIES ( 1, curMonth, 1 ), "MonthNum", [Value] )

VAR sumBCur =
    SUMX ( monthList, VAR m = [MonthNum] RETURN CALCULATE ( [NC BBI exist], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = curYear * 100 + m ) ) )
VAR sumBPrev =
    SUMX ( monthList, VAR m = [MonthNum] RETURN CALCULATE ( [NC BBI exist], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = prevYear * 100 + m ) ) )
VAR sumNCur =
    SUMX ( monthList, VAR m = [MonthNum] RETURN CALCULATE ( [NC BBI exist not], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = curYear * 100 + m ) ) )
VAR sumNPrev =
    SUMX ( monthList, VAR m = [MonthNum] RETURN CALCULATE ( [NC BBI exist not], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = prevYear * 100 + m ) ) )
VAR sumGCur =
    SUMX ( monthList, VAR m = [MonthNum] RETURN CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = curYear * 100 + m ) ) )
VAR sumGPrev =
    SUMX ( monthList, VAR m = [MonthNum] RETURN CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = prevYear * 100 + m ) ) )

VAR diffB = sumBCur - sumBPrev
VAR diffN = sumNCur - sumNPrev
VAR diffG = sumGCur - sumGPrev

VAR rateCur   = DIVIDE ( sumBCur, sumGCur )
VAR ratePrev  = DIVIDE ( sumBPrev, sumGPrev )
VAR rateDiff  = rateCur - ratePrev

VAR deltaG = FORMAT ( DIVIDE ( diffG, sumGPrev ), "+0%;-0%;0%" )
VAR deltaB_val = FORMAT ( ABS ( rateDiff ) * 100, "0.0" )
VAR deltaB = IF ( rateDiff >= 0, "+", "-" ) & deltaB_val & " Ppkt"
VAR arDG = IF ( diffG >= 0, "&#9650;", "&#9660;" )
VAR arDB = IF ( rateDiff >= 0, "&#9650;", "&#9660;" )

VAR colB = IF ( diffB >= 0, "#7a1a1a", "#27500a" )
VAR bgB  = IF ( diffB >= 0, "#fcebeb", "#eaf3de" )
VAR arB  = IF ( diffB >= 0, "&#9650;", "&#9660;" )
VAR colN = IF ( diffN >= 0, "#27500a", "#7a1a1a" )
VAR bgN  = IF ( diffN >= 0, "#eaf3de", "#fcebeb" )
VAR arN  = IF ( diffN >= 0, "&#9650;", "&#9660;" )

VAR ribbonGood = rateDiff <= 0
VAR ribbonCol  = IF ( ribbonGood, "#1a4d0f", "#7a1a1a" )
VAR ribbonBg   = IF ( ribbonGood, "linear-gradient(90deg,#eaf3de,#dcecc9)", "linear-gradient(90deg,#fcebeb,#f8d7d7)" )
VAR ribbonAr   = IF ( ribbonGood, "&#9660;", "&#9650;" )
VAR ribbonTxt  = IF ( ribbonGood, "Rotational-Risiko sinkt ggu. Vorjahr (YTD)", "Rotational-Risiko steigt ggu. Vorjahr (YTD)" )

VAR MonthAbbrLast =
    SWITCH ( curMonth, 1,"Jan",2,"Feb",3,"Mar",4,"Apr",5,"Mai",6,"Jun",7,"Jul",8,"Aug",9,"Sep",10,"Okt",11,"Nov",12,"Dez","" )

VAR yearBadge = curYear & " vs. " & prevYear & " - Jan-" & MonthAbbrLast

VAR sparkVBW = 200
VAR sparkVBH = 40
VAR sparkPadX = 6
VAR sparkPadY = 5
VAR usableW = sparkVBW - ( 2 * sparkPadX )
VAR usableH = sparkVBH - ( 2 * sparkPadY )
VAR ptCount = MAX ( curMonth - 1, 1 )

-- ======================== BBI-ANTEIL-LINIE: GEGLAETTETER PFAD + GLOW ========================
VAR gRateList =
    ADDCOLUMNS ( monthList,
        "@rate",
            VAR m = [MonthNum]
            RETURN DIVIDE (
                CALCULATE ( [NC BBI exist], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = curYear * 100 + m ) ),
                CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = curYear * 100 + m ) )
            )
    )
VAR rMin = MINX ( gRateList, [@rate] )
VAR rMax = MAXX ( gRateList, [@rate] )
VAR rRange = MAX ( rMax - rMin, 0.0001 )
VAR sparkRateLastX = sparkPadX + ptCount * DIVIDE ( usableW, ptCount )
VAR sparkRateLastY = sparkPadY + ( usableH - DIVIDE ( MAXX ( FILTER ( gRateList, [MonthNum] = curMonth ), [@rate] ) - rMin, rRange ) * usableH )
VAR smoothPathRate =
    CONCATENATEX (
        gRateList,
        VAR m = [MonthNum]
        VAR idx = m - 1
        VAR x = sparkPadX + idx * DIVIDE ( usableW, ptCount )
        VAR y = sparkPadY + ( usableH - DIVIDE ( [@rate] - rMin, rRange ) * usableH )
        VAR rPrev = MAXX ( FILTER ( gRateList, [MonthNum] = m - 1 ), [@rate] )
        VAR idxPrev = idx - 1
        VAR xPrev = sparkPadX + idxPrev * DIVIDE ( usableW, ptCount )
        VAR yPrev = sparkPadY + ( usableH - DIVIDE ( rPrev - rMin, rRange ) * usableH )
        VAR midX = DIVIDE ( xPrev + x, 2 )
        VAR midY = DIVIDE ( yPrev + y, 2 )
        RETURN
            IF ( m = 1,
                "M " & FORMAT ( x, "0.0" ) & "," & FORMAT ( y, "0.0" ),
                "Q " & FORMAT ( xPrev, "0.0" ) & "," & FORMAT ( yPrev, "0.0" ) & " " & FORMAT ( midX, "0.0" ) & "," & FORMAT ( midY, "0.0" )
            ),
        " ",
        [MonthNum], ASC
    ) & " L " & FORMAT ( sparkRateLastX, "0.0" ) & "," & FORMAT ( sparkRateLastY, "0.0" )
VAR areaPathRate =
    smoothPathRate
    & " L " & FORMAT ( sparkPadX + usableW, "0.0" ) & "," & FORMAT ( sparkPadY + usableH, "0.0" )
    & " L " & FORMAT ( sparkPadX, "0.0" ) & "," & FORMAT ( sparkPadY + usableH, "0.0" ) & " Z"

-- ======================== NC-GESAMT-LINIE: GEGLAETTETER PFAD + GLOW ========================
VAR gGesList =
    ADDCOLUMNS ( monthList,
        "@ges",
            VAR m = [MonthNum]
            RETURN CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = curYear * 100 + m ) )
    )
VAR gMin = MINX ( gGesList, [@ges] )
VAR gMax = MAXX ( gGesList, [@ges] )
VAR gRange = MAX ( gMax - gMin, 1 )
VAR sparkGesLastX = sparkRateLastX
VAR sparkGesLastY = sparkPadY + ( usableH - DIVIDE ( MAXX ( FILTER ( gGesList, [MonthNum] = curMonth ), [@ges] ) - gMin, gRange ) * usableH )
VAR smoothPathGes =
    CONCATENATEX (
        gGesList,
        VAR m = [MonthNum]
        VAR idx = m - 1
        VAR x = sparkPadX + idx * DIVIDE ( usableW, ptCount )
        VAR y = sparkPadY + ( usableH - DIVIDE ( [@ges] - gMin, gRange ) * usableH )
        VAR gPrev = MAXX ( FILTER ( gGesList, [MonthNum] = m - 1 ), [@ges] )
        VAR idxPrev = idx - 1
        VAR xPrev = sparkPadX + idxPrev * DIVIDE ( usableW, ptCount )
        VAR yPrev = sparkPadY + ( usableH - DIVIDE ( gPrev - gMin, gRange ) * usableH )
        VAR midX = DIVIDE ( xPrev + x, 2 )
        VAR midY = DIVIDE ( yPrev + y, 2 )
        RETURN
            IF ( m = 1,
                "M " & FORMAT ( x, "0.0" ) & "," & FORMAT ( y, "0.0" ),
                "Q " & FORMAT ( xPrev, "0.0" ) & "," & FORMAT ( yPrev, "0.0" ) & " " & FORMAT ( midX, "0.0" ) & "," & FORMAT ( midY, "0.0" )
            ),
        " ",
        [MonthNum], ASC
    ) & " L " & FORMAT ( sparkGesLastX, "0.0" ) & "," & FORMAT ( sparkGesLastY, "0.0" )
VAR areaPathGes =
    smoothPathGes
    & " L " & FORMAT ( sparkPadX + usableW, "0.0" ) & "," & FORMAT ( sparkPadY + usableH, "0.0" )
    & " L " & FORMAT ( sparkPadX, "0.0" ) & "," & FORMAT ( sparkPadY + usableH, "0.0" ) & " Z"

VAR icEmblem = "<span style=" & UNICHAR(34) & "display:inline-flex;filter:drop-shadow(0 2px 3px rgba(0,0,0,.18))" & UNICHAR(34) & "><svg width=" & UNICHAR(34) & "26" & UNICHAR(34) & " height=" & UNICHAR(34) & "26" & UNICHAR(34) & " viewBox=" & UNICHAR(34) & "0 0 48 48" & UNICHAR(34) & "><defs><linearGradient id=" & UNICHAR(34) & "gKern" & UNICHAR(34) & " x1=" & UNICHAR(34) & "0" & UNICHAR(34) & " y1=" & UNICHAR(34) & "0" & UNICHAR(34) & " x2=" & UNICHAR(34) & "1" & UNICHAR(34) & " y2=" & UNICHAR(34) & "1" & UNICHAR(34) & "><stop offset=" & UNICHAR(34) & "0" & UNICHAR(34) & " stop-color=" & UNICHAR(34) & "#5b8db8" & UNICHAR(34) & "/><stop offset=" & UNICHAR(34) & "1" & UNICHAR(34) & " stop-color=" & UNICHAR(34) & "#2f5a82" & UNICHAR(34) & "/></linearGradient><linearGradient id=" & UNICHAR(34) & "gRing" & UNICHAR(34) & " x1=" & UNICHAR(34) & "0" & UNICHAR(34) & " y1=" & UNICHAR(34) & "0" & UNICHAR(34) & " x2=" & UNICHAR(34) & "1" & UNICHAR(34) & " y2=" & UNICHAR(34) & "1" & UNICHAR(34) & "><stop offset=" & UNICHAR(34) & "0" & UNICHAR(34) & " stop-color=" & UNICHAR(34) & "#D4503F" & UNICHAR(34) & "/><stop offset=" & UNICHAR(34) & "1" & UNICHAR(34) & " stop-color=" & UNICHAR(34) & "#a01f1f" & UNICHAR(34) & "/></linearGradient></defs><circle cx=" & UNICHAR(34) & "24" & UNICHAR(34) & " cy=" & UNICHAR(34) & "24" & UNICHAR(34) & " r=" & UNICHAR(34) & "18" & UNICHAR(34) & " fill=" & UNICHAR(34) & "none" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "#EEECEA" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "6" & UNICHAR(34) & "/><circle cx=" & UNICHAR(34) & "24" & UNICHAR(34) & " cy=" & UNICHAR(34) & "24" & UNICHAR(34) & " r=" & UNICHAR(34) & "18" & UNICHAR(34) & " fill=" & UNICHAR(34) & "none" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "url(#gRing)" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "6" & UNICHAR(34) & " stroke-linecap=" & UNICHAR(34) & "round" & UNICHAR(34) & " stroke-dasharray=" & UNICHAR(34) & "62 113" & UNICHAR(34) & " transform=" & UNICHAR(34) & "rotate(-90 24 24)" & UNICHAR(34) & "/><path d=" & UNICHAR(34) & "M24 4 l5 5 -5 5 z" & UNICHAR(34) & " fill=" & UNICHAR(34) & "#a01f1f" & UNICHAR(34) & "/><circle cx=" & UNICHAR(34) & "24" & UNICHAR(34) & " cy=" & UNICHAR(34) & "24" & UNICHAR(34) & " r=" & UNICHAR(34) & "7" & UNICHAR(34) & " fill=" & UNICHAR(34) & "url(#gKern)" & UNICHAR(34) & "/></svg></span>"
VAR icChart = "<svg width=" & UNICHAR(34) & "15" & UNICHAR(34) & " height=" & UNICHAR(34) & "15" & UNICHAR(34) & " viewBox=" & UNICHAR(34) & "0 0 24 24" & UNICHAR(34) & " fill=" & UNICHAR(34) & "none" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "currentColor" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "2" & UNICHAR(34) & " stroke-linecap=" & UNICHAR(34) & "round" & UNICHAR(34) & " stroke-linejoin=" & UNICHAR(34) & "round" & UNICHAR(34) & "><path d=" & UNICHAR(34) & "M4 19h16M7 16v-5M12 16V8M17 16v-8" & UNICHAR(34) & "/></svg>"
VAR icAlert = "<svg width=" & UNICHAR(34) & "15" & UNICHAR(34) & " height=" & UNICHAR(34) & "15" & UNICHAR(34) & " viewBox=" & UNICHAR(34) & "0 0 24 24" & UNICHAR(34) & " fill=" & UNICHAR(34) & "none" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "currentColor" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "2" & UNICHAR(34) & " stroke-linecap=" & UNICHAR(34) & "round" & UNICHAR(34) & " stroke-linejoin=" & UNICHAR(34) & "round" & UNICHAR(34) & "><path d=" & UNICHAR(34) & "M12 9v4M12 17h.01M10.2 3.3 1.6 18a2 2 0 0 0 1.7 3h17.4a2 2 0 0 0 1.7-3L13.8 3.3a2 2 0 0 0-3.6 0z" & UNICHAR(34) & "/></svg>"
VAR icTrend = "<svg width=" & UNICHAR(34) & "12" & UNICHAR(34) & " height=" & UNICHAR(34) & "12" & UNICHAR(34) & " viewBox=" & UNICHAR(34) & "0 0 24 24" & UNICHAR(34) & " fill=" & UNICHAR(34) & "none" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "currentColor" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "2.2" & UNICHAR(34) & " stroke-linecap=" & UNICHAR(34) & "round" & UNICHAR(34) & " stroke-linejoin=" & UNICHAR(34) & "round" & UNICHAR(34) & "><path d=" & UNICHAR(34) & "M3 17l6-6 4 4 8-8M14 7h7v7" & UNICHAR(34) & "/></svg>"
VAR icCalYoY = "<svg width=" & UNICHAR(34) & "13" & UNICHAR(34) & " height=" & UNICHAR(34) & "13" & UNICHAR(34) & " viewBox=" & UNICHAR(34) & "0 0 24 24" & UNICHAR(34) & " fill=" & UNICHAR(34) & "none" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "currentColor" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "2" & UNICHAR(34) & " stroke-linecap=" & UNICHAR(34) & "round" & UNICHAR(34) & " stroke-linejoin=" & UNICHAR(34) & "round" & UNICHAR(34) & "><rect x=" & UNICHAR(34) & "3" & UNICHAR(34) & " y=" & UNICHAR(34) & "4" & UNICHAR(34) & " width=" & UNICHAR(34) & "18" & UNICHAR(34) & " height=" & UNICHAR(34) & "17" & UNICHAR(34) & " rx=" & UNICHAR(34) & "2" & UNICHAR(34) & "/><path d=" & UNICHAR(34) & "M3 9h18M8 2v4M16 2v4" & UNICHAR(34) & "/><path d=" & UNICHAR(34) & "M8 14l3 3 5-6" & UNICHAR(34) & " /></svg>"

-- ======================== ROTE BALKEN: HOEHE NACH PROZENT-ANTEIL (b/g) ========================
VAR maxBPct =
    MAXX ( monthList,
        VAR m = [MonthNum]
        VAR ymCur  = curYear * 100 + m
        VAR ymPrev = prevYear * 100 + m
        VAR pCur  = DIVIDE (
            CALCULATE ( [NC BBI exist], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymCur ) ),
            CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymCur ) )
        )
        VAR pPrev = DIVIDE (
            CALCULATE ( [NC BBI exist], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymPrev ) ),
            CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymPrev ) )
        )
        RETURN MAX ( pCur, pPrev )
    )
VAR redBars =
    CONCATENATEX (
        monthList,
        VAR m = [MonthNum]
        VAR isLast = m = curMonth
        VAR ymCur  = curYear * 100 + m
        VAR ymPrev = prevYear * 100 + m
        VAR b   = CALCULATE ( [NC BBI exist], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymCur ) )
        VAR g   = CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymCur ) )
        VAR bPY = CALCULATE ( [NC BBI exist], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymPrev ) )
        VAR gPY = CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymPrev ) )
        VAR pBval   = DIVIDE ( b, g )
        VAR pBPYval = DIVIDE ( bPY, gPY )
        VAR pB   = FORMAT ( pBval, "0%" )
        VAR pBPY = FORMAT ( pBPYval, "0%" )
        VAR hB   = FORMAT ( DIVIDE ( pBval, maxBPct ) * maxH, "0" )
        VAR hBPY = FORMAT ( DIVIDE ( pBPYval, maxBPct ) * maxH, "0" )
        RETURN
            "<div style=" & UNICHAR(34) & "flex:1;display:flex;flex-direction:column;align-items:center" & UNICHAR(34) & ">"
            & "<div style=" & UNICHAR(34) & "font-size:12px;color:#c0392b;font-weight:700;margin-bottom:3px" & UNICHAR(34) & ">" & FORMAT ( b, "#,##0" )
            &   IF ( NOT ISBLANK ( bPY ), " <span style=" & UNICHAR(34) & "font-size:9px;color:#6B7280;font-weight:400" & UNICHAR(34) & ">/ " & FORMAT ( bPY, "#,##0" ) & " VJ</span>", "" ) & "</div>"
            & "<div style=" & UNICHAR(34) & "display:flex;align-items:flex-end;gap:4px;width:100%;justify-content:center" & UNICHAR(34) & ">"
            &   "<div style=" & UNICHAR(34) & "flex:0 0 58%;height:" & hB & "px;min-height:2px;background:linear-gradient(180deg,#D4503F,#C0392B);border-radius:4px 4px 0 0;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 3px rgba(0,0,0,.12)"
            &     IF ( isLast, ";outline:2px solid #7a1a1a;outline-offset:-2px", "" ) & UNICHAR(34) & "><span style=" & UNICHAR(34) & "font-size:11px;font-weight:700;color:#fff" & UNICHAR(34) & ">" & pB & "</span></div>"
            &   IF ( NOT ISBLANK ( bPY ),
                    "<div style=" & UNICHAR(34) & "flex:0 0 30%;height:" & hBPY & "px;min-height:2px;background:#D7DBE0;border-radius:4px 4px 0 0;display:flex;align-items:center;justify-content:center" & UNICHAR(34) & "><span style=" & UNICHAR(34) & "font-size:9px;font-weight:700;color:#374151" & UNICHAR(34) & ">" & pBPY & "</span></div>",
                    "" )
            & "</div>"
            & "</div>",
        "",
        [MonthNum], ASC
    )
VAR redChip =
    "<div style=" & UNICHAR(34) & "flex:0 0 74px;align-self:stretch;display:flex;flex-direction:column;justify-content:flex-end" & UNICHAR(34) & ">"
    & "<div style=" & UNICHAR(34) & "font-size:12px;font-weight:700;color:" & colB & ";background:" & bgB & ";border-radius:5px;padding:4px 6px;text-align:center;line-height:1.35" & UNICHAR(34) & ">"
    & arB & " " & FORMAT ( ABS ( diffB ), "#,##0" ) & "<br><span style=" & UNICHAR(34) & "font-size:9px" & UNICHAR(34) & ">" & FORMAT ( DIVIDE ( diffB, sumBPrev ), "+0%;-0%;0%" ) & " YTD</span></div></div>"

-- ======================== BLAUE BALKEN: HOEHE NACH PROZENT-ANTEIL (n/g) ========================
VAR maxNPct =
    MAXX ( monthList,
        VAR m = [MonthNum]
        VAR ymCur  = curYear * 100 + m
        VAR ymPrev = prevYear * 100 + m
        VAR pCur  = DIVIDE (
            CALCULATE ( [NC BBI exist not], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymCur ) ),
            CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymCur ) )
        )
        VAR pPrev = DIVIDE (
            CALCULATE ( [NC BBI exist not], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymPrev ) ),
            CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymPrev ) )
        )
        RETURN MAX ( pCur, pPrev )
    )
VAR blueBars =
    CONCATENATEX (
        monthList,
        VAR m = [MonthNum]
        VAR isLast = m = curMonth
        VAR ymCur  = curYear * 100 + m
        VAR ymPrev = prevYear * 100 + m
        VAR n   = CALCULATE ( [NC BBI exist not], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymCur ) )
        VAR g   = CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymCur ) )
        VAR nPY = CALCULATE ( [NC BBI exist not], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymPrev ) )
        VAR gPY = CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = ymPrev ) )
        VAR pNval   = DIVIDE ( n, g )
        VAR pNPYval = DIVIDE ( nPY, gPY )
        VAR pN   = FORMAT ( pNval, "0%" )
        VAR pNPY = FORMAT ( pNPYval, "0%" )
        VAR hN   = FORMAT ( DIVIDE ( pNval, maxNPct ) * maxH, "0" )
        VAR hNPY = FORMAT ( DIVIDE ( pNPYval, maxNPct ) * maxH, "0" )
        RETURN
            "<div style=" & UNICHAR(34) & "flex:1;display:flex;flex-direction:column;align-items:center" & UNICHAR(34) & ">"
            & "<div style=" & UNICHAR(34) & "font-size:12px;color:#5b8db8;font-weight:700;margin-bottom:3px" & UNICHAR(34) & ">" & FORMAT ( n, "#,##0" )
            &   IF ( NOT ISBLANK ( nPY ), " <span style=" & UNICHAR(34) & "font-size:9px;color:#6B7280;font-weight:400" & UNICHAR(34) & ">/ " & FORMAT ( nPY, "#,##0" ) & " VJ</span>", "" ) & "</div>"
            & "<div style=" & UNICHAR(34) & "display:flex;align-items:flex-end;gap:4px;width:100%;justify-content:center" & UNICHAR(34) & ">"
            &   "<div style=" & UNICHAR(34) & "flex:0 0 58%;height:" & hN & "px;min-height:2px;background:linear-gradient(180deg,#6E9CC4,#5b8db8);border-radius:4px 4px 0 0;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 3px rgba(0,0,0,.12)"
            &     IF ( isLast, ";outline:2px solid #2f5a82;outline-offset:-2px", "" ) & UNICHAR(34) & "><span style=" & UNICHAR(34) & "font-size:11px;font-weight:700;color:#fff" & UNICHAR(34) & ">" & pN & "</span></div>"
            &   IF ( NOT ISBLANK ( nPY ),
                    "<div style=" & UNICHAR(34) & "flex:0 0 30%;height:" & hNPY & "px;min-height:2px;background:#D7DBE0;border-radius:4px 4px 0 0;display:flex;align-items:center;justify-content:center" & UNICHAR(34) & "><span style=" & UNICHAR(34) & "font-size:9px;font-weight:700;color:#374151" & UNICHAR(34) & ">" & pNPY & "</span></div>",
                    "" )
            & "</div>"
            & "</div>",
        "",
        [MonthNum], ASC
    )
VAR blueChip =
    "<div style=" & UNICHAR(34) & "flex:0 0 74px;align-self:stretch;display:flex;flex-direction:column;justify-content:flex-end" & UNICHAR(34) & ">"
    & "<div style=" & UNICHAR(34) & "font-size:12px;font-weight:700;color:" & colN & ";background:" & bgN & ";border-radius:5px;padding:4px 6px;text-align:center;line-height:1.35" & UNICHAR(34) & ">"
    & arN & " " & FORMAT ( ABS ( diffN ), "#,##0" ) & "<br><span style=" & UNICHAR(34) & "font-size:9px" & UNICHAR(34) & ">" & FORMAT ( DIVIDE ( diffN, sumNPrev ), "+0%;-0%;0%" ) & " YTD</span></div></div>"

VAR monthLabels =
    CONCATENATEX (
        monthList,
        VAR m = [MonthNum]
        VAR isLast = m = curMonth
        VAR g = CALCULATE ( [NC Gesamt], FILTER ( ALL ( DateTimeTable ), DateTimeTable[Year_Month_NUM] = curYear * 100 + m ) )
        VAR mL = SWITCH ( m, 1,"Jan",2,"Feb",3,"Mar",4,"Apr",5,"Mai",6,"Jun",7,"Jul",8,"Aug",9,"Sep",10,"Okt",11,"Nov",12,"Dez","" )
        RETURN
            "<div style=" & UNICHAR(34) & "flex:1;text-align:center" & UNICHAR(34) & "><div style=" & UNICHAR(34) & "font-size:11px;"
            & IF ( isLast, "color:#fff;background:#c0392b;font-weight:600;padding:1px 8px;border-radius:10px;display:inline-block", "color:#A19F9D" )
            & UNICHAR(34) & ">" & mL & "</div><div style=" & UNICHAR(34) & "font-size:10px;color:#605E5C;margin-top:1px" & UNICHAR(34) & ">" & FORMAT ( g, "#,##0" ) & "</div></div>",
        "",
        [MonthNum], ASC
    )

RETURN
"<div style=" & UNICHAR(34) & "font-family:Segoe UI,Roboto,sans-serif;color:#252423;padding:10px 0" & UNICHAR(34) & ">"
& "<div style=" & UNICHAR(34) & "display:flex;justify-content:space-between;align-items:center;margin-bottom:10px" & UNICHAR(34) & ">"
&   "<div style=" & UNICHAR(34) & "display:flex;align-items:center;gap:10px" & UNICHAR(34) & ">"
&     icEmblem
&     "<span style=" & UNICHAR(34) & "font-size:11px;font-weight:600;color:#605E5C;text-transform:uppercase;letter-spacing:.06em" & UNICHAR(34) & ">Rotational-Risiko & Neugeschaeft - Jahresvergleich</span>"
&   "</div>"
&   "<span style=" & UNICHAR(34) & "font-size:11px;font-weight:600;color:#fff;background:#c0392b;padding:3px 10px;border-radius:5px" & UNICHAR(34) & ">" & yearBadge & "</span>"
& "</div>"

& "<div style=" & UNICHAR(34) & "display:flex;align-items:center;gap:10px;padding:9px 14px;border-radius:9px;background:" & ribbonBg & ";margin-bottom:12px;box-shadow:0 1px 4px rgba(0,0,0,.05)" & UNICHAR(34) & ">"
&   "<span style=" & UNICHAR(34) & "display:inline-flex;color:" & ribbonCol & UNICHAR(34) & ">" & icCalYoY & "</span>"
&   "<span style=" & UNICHAR(34) & "font-size:12px;font-weight:700;color:" & ribbonCol & UNICHAR(34) & ">" & ribbonAr & " " & ribbonTxt & "</span>"
&   "<span style=" & UNICHAR(34) & "font-size:11px;color:" & ribbonCol & ";margin-left:auto;font-weight:600" & UNICHAR(34) & ">BBI-Anteil " & FORMAT ( ratePrev, "0%" ) & " -> " & FORMAT ( rateCur, "0%" ) & " (" & deltaB & ")</span>"
& "</div>"

& "<div style=" & UNICHAR(34) & "border:1px solid #E8E6E3;border-radius:10px;padding:14px 16px;box-shadow:0 1px 6px rgba(0,0,0,.05);background:#fff" & UNICHAR(34) & ">"

& "<div style=" & UNICHAR(34) & "font-size:12px;color:#A19F9D;margin-bottom:8px" & UNICHAR(34) & ">YTD " & curYear & ": <b style=" & UNICHAR(34) & "color:#252423" & UNICHAR(34) & ">Jan-" & MonthAbbrLast & "</b> - Vergleich zum Vorjahr (" & prevYear & ")</div>"
& "<div style=" & UNICHAR(34) & "display:flex;gap:8px;margin-bottom:14px" & UNICHAR(34) & ">"
&   "<div style=" & UNICHAR(34) & "flex:1;padding:10px 12px;border-radius:8px;background:#5b8db8;color:#fff" & UNICHAR(34) & ">"
&     "<span style=" & UNICHAR(34) & "display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;margin-bottom:6px" & UNICHAR(34) & ">" & icChart & "NC Gesamt YTD</span>"
&     "<div style=" & UNICHAR(34) & "font-size:18px;font-weight:700;margin-bottom:2px" & UNICHAR(34) & ">" & FORMAT ( sumGCur, "#,##0" ) & " <span style=" & UNICHAR(34) & "font-size:11px;font-weight:600;opacity:.9" & UNICHAR(34) & ">" & arDG & " " & deltaG & " vs. VJ</span></div>"
&     "<svg viewBox=" & UNICHAR(34) & "0 0 " & sparkVBW & " " & sparkVBH & UNICHAR(34) & " style=" & UNICHAR(34) & "width:100%;height:38px;display:block;margin:4px 0 2px" & UNICHAR(34) & ">"
&       "<defs>"
&         "<linearGradient id=" & UNICHAR(34) & "gAreaGes" & UNICHAR(34) & " x1=" & UNICHAR(34) & "0" & UNICHAR(34) & " y1=" & UNICHAR(34) & "0" & UNICHAR(34) & " x2=" & UNICHAR(34) & "0" & UNICHAR(34) & " y2=" & UNICHAR(34) & "1" & UNICHAR(34) & "><stop offset=" & UNICHAR(34) & "0" & UNICHAR(34) & " stop-color=" & UNICHAR(34) & "#ffffff" & UNICHAR(34) & " stop-opacity=" & UNICHAR(34) & "0.4" & UNICHAR(34) & "/><stop offset=" & UNICHAR(34) & "1" & UNICHAR(34) & " stop-color=" & UNICHAR(34) & "#ffffff" & UNICHAR(34) & " stop-opacity=" & UNICHAR(34) & "0" & UNICHAR(34) & "/></linearGradient>"
&         "<filter id=" & UNICHAR(34) & "fGlowGes" & UNICHAR(34) & " x=" & UNICHAR(34) & "-20%" & UNICHAR(34) & " y=" & UNICHAR(34) & "-60%" & UNICHAR(34) & " width=" & UNICHAR(34) & "140%" & UNICHAR(34) & " height=" & UNICHAR(34) & "220%" & UNICHAR(34) & "><feGaussianBlur stdDeviation=" & UNICHAR(34) & "1.1" & UNICHAR(34) & " result=" & UNICHAR(34) & "b" & UNICHAR(34) & "/><feMerge><feMergeNode in=" & UNICHAR(34) & "b" & UNICHAR(34) & "/><feMergeNode in=" & UNICHAR(34) & "SourceGraphic" & UNICHAR(34) & "/></feMerge></filter>"
&       "</defs>"
&       "<line x1=" & UNICHAR(34) & FORMAT ( sparkPadX, "0" ) & UNICHAR(34) & " y1=" & UNICHAR(34) & FORMAT ( sparkPadY + usableH / 2, "0" ) & UNICHAR(34) & " x2=" & UNICHAR(34) & FORMAT ( sparkPadX + usableW, "0" ) & UNICHAR(34) & " y2=" & UNICHAR(34) & FORMAT ( sparkPadY + usableH / 2, "0" ) & UNICHAR(34) & " stroke=" & UNICHAR(34) & "rgba(255,255,255,.16)" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "1" & UNICHAR(34) & "/>"
&       "<path d=" & UNICHAR(34) & areaPathGes & UNICHAR(34) & " fill=" & UNICHAR(34) & "url(#gAreaGes)" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "none" & UNICHAR(34) & "/>"
&       "<path d=" & UNICHAR(34) & smoothPathGes & UNICHAR(34) & " fill=" & UNICHAR(34) & "none" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "#fff" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "2.2" & UNICHAR(34) & " stroke-linecap=" & UNICHAR(34) & "round" & UNICHAR(34) & " stroke-linejoin=" & UNICHAR(34) & "round" & UNICHAR(34) & " filter=" & UNICHAR(34) & "url(#fGlowGes)" & UNICHAR(34) & "/>"
&       "<circle cx=" & UNICHAR(34) & FORMAT ( sparkGesLastX, "0.0" ) & UNICHAR(34) & " cy=" & UNICHAR(34) & FORMAT ( sparkGesLastY, "0.0" ) & UNICHAR(34) & " r=" & UNICHAR(34) & "7" & UNICHAR(34) & " fill=" & UNICHAR(34) & "#fff" & UNICHAR(34) & " fill-opacity=" & UNICHAR(34) & "0.22" & UNICHAR(34) & "/>"
&       "<circle cx=" & UNICHAR(34) & FORMAT ( sparkGesLastX, "0.0" ) & UNICHAR(34) & " cy=" & UNICHAR(34) & FORMAT ( sparkGesLastY, "0.0" ) & UNICHAR(34) & " r=" & UNICHAR(34) & "4" & UNICHAR(34) & " fill=" & UNICHAR(34) & "#fff" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "#2f5a82" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "1.4" & UNICHAR(34) & "/>"
&     "</svg>"
&     "<div style=" & UNICHAR(34) & "font-size:9.5px;opacity:.9;line-height:1.3" & UNICHAR(34) & ">Monatsverlauf " & curYear & " (Jan-" & MonthAbbrLast & ") - Volumenwachstum ggu. Vorjahreszeitraum, relativ</div>"
&   "</div>"
&   "<div style=" & UNICHAR(34) & "flex:1;padding:10px 12px;border-radius:8px;background:#c0392b;color:#fff" & UNICHAR(34) & ">"
&     "<span style=" & UNICHAR(34) & "display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;margin-bottom:6px" & UNICHAR(34) & ">" & icAlert & "BBI-Anteil YTD</span>"
&     "<div style=" & UNICHAR(34) & "font-size:18px;font-weight:700;margin-bottom:2px" & UNICHAR(34) & ">" & FORMAT ( rateCur, "0%" ) & " <span style=" & UNICHAR(34) & "font-size:11px;font-weight:600;opacity:.9" & UNICHAR(34) & ">" & arDB & " " & deltaB & " vs. VJ</span></div>"
&     "<svg viewBox=" & UNICHAR(34) & "0 0 " & sparkVBW & " " & sparkVBH & UNICHAR(34) & " style=" & UNICHAR(34) & "width:100%;height:38px;display:block;margin:4px 0 2px" & UNICHAR(34) & ">"
&       "<defs>"
&         "<linearGradient id=" & UNICHAR(34) & "gAreaRate" & UNICHAR(34) & " x1=" & UNICHAR(34) & "0" & UNICHAR(34) & " y1=" & UNICHAR(34) & "0" & UNICHAR(34) & " x2=" & UNICHAR(34) & "0" & UNICHAR(34) & " y2=" & UNICHAR(34) & "1" & UNICHAR(34) & "><stop offset=" & UNICHAR(34) & "0" & UNICHAR(34) & " stop-color=" & UNICHAR(34) & "#ffffff" & UNICHAR(34) & " stop-opacity=" & UNICHAR(34) & "0.4" & UNICHAR(34) & "/><stop offset=" & UNICHAR(34) & "1" & UNICHAR(34) & " stop-color=" & UNICHAR(34) & "#ffffff" & UNICHAR(34) & " stop-opacity=" & UNICHAR(34) & "0" & UNICHAR(34) & "/></linearGradient>"
&         "<filter id=" & UNICHAR(34) & "fGlowRate" & UNICHAR(34) & " x=" & UNICHAR(34) & "-20%" & UNICHAR(34) & " y=" & UNICHAR(34) & "-60%" & UNICHAR(34) & " width=" & UNICHAR(34) & "140%" & UNICHAR(34) & " height=" & UNICHAR(34) & "220%" & UNICHAR(34) & "><feGaussianBlur stdDeviation=" & UNICHAR(34) & "1.1" & UNICHAR(34) & " result=" & UNICHAR(34) & "b" & UNICHAR(34) & "/><feMerge><feMergeNode in=" & UNICHAR(34) & "b" & UNICHAR(34) & "/><feMergeNode in=" & UNICHAR(34) & "SourceGraphic" & UNICHAR(34) & "/></feMerge></filter>"
&       "</defs>"
&       "<line x1=" & UNICHAR(34) & FORMAT ( sparkPadX, "0" ) & UNICHAR(34) & " y1=" & UNICHAR(34) & FORMAT ( sparkPadY + usableH / 2, "0" ) & UNICHAR(34) & " x2=" & UNICHAR(34) & FORMAT ( sparkPadX + usableW, "0" ) & UNICHAR(34) & " y2=" & UNICHAR(34) & FORMAT ( sparkPadY + usableH / 2, "0" ) & UNICHAR(34) & " stroke=" & UNICHAR(34) & "rgba(255,255,255,.16)" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "1" & UNICHAR(34) & "/>"
&       "<path d=" & UNICHAR(34) & areaPathRate & UNICHAR(34) & " fill=" & UNICHAR(34) & "url(#gAreaRate)" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "none" & UNICHAR(34) & "/>"
&       "<path d=" & UNICHAR(34) & smoothPathRate & UNICHAR(34) & " fill=" & UNICHAR(34) & "none" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "#fff" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "2.2" & UNICHAR(34) & " stroke-linecap=" & UNICHAR(34) & "round" & UNICHAR(34) & " stroke-linejoin=" & UNICHAR(34) & "round" & UNICHAR(34) & " filter=" & UNICHAR(34) & "url(#fGlowRate)" & UNICHAR(34) & "/>"
&       "<circle cx=" & UNICHAR(34) & FORMAT ( sparkRateLastX, "0.0" ) & UNICHAR(34) & " cy=" & UNICHAR(34) & FORMAT ( sparkRateLastY, "0.0" ) & UNICHAR(34) & " r=" & UNICHAR(34) & "7" & UNICHAR(34) & " fill=" & UNICHAR(34) & "#fff" & UNICHAR(34) & " fill-opacity=" & UNICHAR(34) & "0.22" & UNICHAR(34) & "/>"
&       "<circle cx=" & UNICHAR(34) & FORMAT ( sparkRateLastX, "0.0" ) & UNICHAR(34) & " cy=" & UNICHAR(34) & FORMAT ( sparkRateLastY, "0.0" ) & UNICHAR(34) & " r=" & UNICHAR(34) & "4" & UNICHAR(34) & " fill=" & UNICHAR(34) & "#fff" & UNICHAR(34) & " stroke=" & UNICHAR(34) & "#7a1a1a" & UNICHAR(34) & " stroke-width=" & UNICHAR(34) & "1.4" & UNICHAR(34) & "/>"
&     "</svg>"
&     "<div style=" & UNICHAR(34) & "font-size:9.5px;opacity:.9;line-height:1.3" & UNICHAR(34) & ">Anteil NC BBI exist an NC Gesamt, Monat fuer Monat - Delta = Prozentpunkte ggu. Vorjahr</div>"
&   "</div>"
& "</div>"

& "<div style=" & UNICHAR(34) & "display:flex;align-items:center;gap:10px;margin-bottom:2px" & UNICHAR(34) & ">"
&   "<span style=" & UNICHAR(34) & "font-size:11px;color:#c0392b;font-weight:600" & UNICHAR(34) & ">NC BBI exist - Rotational-Risiko (Balkenhoehe = Anteil an NC Gesamt)</span>"
&   "<span style=" & UNICHAR(34) & "display:flex;align-items:center;gap:4px;font-size:9px;color:#605E5C" & UNICHAR(34) & "><span style=" & UNICHAR(34) & "width:9px;height:9px;border-radius:2px;background:#c0392b" & UNICHAR(34) & "></span>aktuell<span style=" & UNICHAR(34) & "width:9px;height:9px;border-radius:2px;background:#D7DBE0;margin-left:6px" & UNICHAR(34) & "></span>Vorjahr</span>"
& "</div>"
& "<div style=" & UNICHAR(34) & "font-size:9px;color:#7a1a1a;font-style:italic;margin:0 0 8px 0" & UNICHAR(34) & ">Echter Rotational Churn = BBI-Kuendigung (Cancellation) innerhalb +/-30 Tage um den GrossAdd-Tag des Cube-Kaufs.</div>"
& "<div style=" & UNICHAR(34) & "display:flex;gap:8px;align-items:flex-end" & UNICHAR(34) & ">" & redBars & redChip & "</div>"

& "<div style=" & UNICHAR(34) & "height:1px;background:#E8E6E3;margin:14px 0" & UNICHAR(34) & "></div>"

& "<div style=" & UNICHAR(34) & "display:flex;align-items:center;gap:8px;margin-bottom:2px" & UNICHAR(34) & ">"
&   "<span style=" & UNICHAR(34) & "width:20px;height:20px;border-radius:6px;background:#E6EEF6;display:inline-flex;align-items:center;justify-content:center;color:#5b8db8" & UNICHAR(34) & ">" & icTrend & "</span>"
&   "<span style=" & UNICHAR(34) & "font-size:11px;color:#5b8db8;font-weight:600" & UNICHAR(34) & ">NC BBI exist not - Echtes Neugeschaeft (Balkenhoehe = Anteil an NC Gesamt)</span>"
&   "<span style=" & UNICHAR(34) & "display:flex;align-items:center;gap:4px;font-size:9px;color:#605E5C;margin-left:auto" & UNICHAR(34) & "><span style=" & UNICHAR(34) & "width:9px;height:9px;border-radius:2px;background:#5b8db8" & UNICHAR(34) & "></span>aktuell<span style=" & UNICHAR(34) & "width:9px;height:9px;border-radius:2px;background:#D7DBE0;margin-left:6px" & UNICHAR(34) & "></span>Vorjahr</span>"
& "</div>"
& "<div style=" & UNICHAR(34) & "font-size:9px;color:#605E5C;margin:0 0 8px 0" & UNICHAR(34) & ">YTD gesamt: " & FORMAT ( sumNCur, "#,##0" ) & " (" & curYear & ") - " & FORMAT ( sumNPrev, "#,##0" ) & " (" & prevYear & ")</div>"
& "<div style=" & UNICHAR(34) & "display:flex;gap:8px;align-items:flex-end" & UNICHAR(34) & ">" & blueBars & blueChip & "</div>"

& "<div style=" & UNICHAR(34) & "display:flex;gap:8px;margin-top:6px" & UNICHAR(34) & ">" & monthLabels & "<div style=" & UNICHAR(34) & "flex:0 0 74px" & UNICHAR(34) & "></div></div>"

& "</div>"
& "</div>"
